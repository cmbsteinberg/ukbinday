# Copy to .env for local runs (uvicorn, docker compose). Production reads the same
# keys from Vercel's project env vars; `npx vercel env ls production` lists them.

# Public-facing URL (used for sitemap, CORS, etc.)
BASE_URL=https://ukbinday.co.uk
FRONTEND_URL=https://ukbinday.co.uk

# CORS allowed origins (comma-separated, defaults to FRONTEND_URL value)
CORS_ORIGINS=https://ukbinday.co.uk

# Environment (set to "production" to enable static file caching)
ENV=production

# Address lookup (proxied server-side by /api/v2/find)
ADDRESS_API_URL=
ADDRESS_API_COMPANY_ID=

# Cloudflare Turnstile (leave both empty to skip the check)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Scraper configuration
SCRAPER_TIMEOUT=30

# Optional Redis: per-IP rate limit and the cross-instance scrape lock. Production
# runs without it; unset disables both.
REDIS_URL=
RATE_LIMIT_HOURLY=200

# ICS cache: a directory at DATA_DIR, or Cloudflare R2 when R2_BUCKET is set.
DATA_DIR=data
# The R2 credentials come from a Cloudflare R2 API token scoped to the bucket
# (Object Read & Write on `bins`): the access key ID is the token's ID, the secret
# is the SHA-256 of the token value. Revoking that token takes the cache offline
# (lookups then scrape live, calendar feeds answer 503).
CLOUDFLARE_API_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Nightly refresh. Production: a Vercel cron calls /api/v2/internal/refresh with
# CRON_SECRET as a Bearer token (the route refuses without it; the weekly Coverage
# workflow sends it too). Local/Docker: RUN_REFRESH_JOB=1 runs it in-process.
CRON_SECRET=
REFRESH_DEADLINE_S=250
RUN_REFRESH_JOB=0
