# Environment for the Vercel project (VERCEL.md phase 4). Copy somewhere outside the repo,
# fill in, then: scripts/vercel/env_push.sh <file> [production|preview]
# Not listed on purpose: REDIS_URL (no Redis on Vercel; the app runs without it).

# Address API (proxied server-side by /api/v2/find)
ADDRESS_API_URL=
ADDRESS_API_COMPANY_ID=

# Cloudflare Turnstile (leave both out of a preview you want to probe)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Public URL, and the origins allowed by CORS (comma-separated)
BASE_URL=https://ukbinday.co.uk
CORS_ORIGINS=https://ukbinday.co.uk

# Cloudflare R2: the ICS cache (S3 API; account id is in the dashboard URL)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bins

# Bearer secret for /api/v2/internal/refresh; Vercel sends it on cron calls.
# Leave empty/absent to have env_push.sh generate one. Set it here if you want to know it
# (needed for scripts/vercel/refresh_now.sh), e.g. the output of: openssl rand -hex 32
CRON_SECRET=

# App settings
ENV=production
LOG_FORMAT=json
SCRAPER_TIMEOUT=30
ICS_REFRESH_CONCURRENCY=8
# The background refresh task cannot run on Vercel; the cron route replaces it
RUN_REFRESH_JOB=0
