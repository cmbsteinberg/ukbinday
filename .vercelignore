# Patterns are anchored with a leading slash so /data (the local ICS cache) doesn't also
# match api/data, which holds the postcodes/ shards and lad_lookup.json at runtime.
# Runtime needs: api/ (incl. api/data, api/static, api/templates, api/councils/_aliases.json),
# pyproject.toml, uv.lock, .python-version and README.md (pyproject's `readme`, which the
# hatchling build of the project reads).

# Build, test and data-pipeline code
/pipeline/
/tests/
/scripts/
/node_modules/
/package.json
/package-lock.json
/biome.json
/lefthook.yaml

# Local ICS cache (the runtime cache lives in R2)
/data/

# Local environments and caches
/.venv/
/.claude/
/.pytest_cache/
/.ruff_cache/
**/.ruff_cache/
**/__pycache__/
*.pyc
.DS_Store

# Leftover local dirs from before the tidy-up (only gitignored .pyc files)
/api/scrapers/
/api/compat/

# Self-hosting infra and docs
/Caddyfile
/goaccess.conf
/docker-compose.yml
/Dockerfile
/.env
/.env.example
/*.md
!/README.md
